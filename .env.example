# LaunchDesk — Supabase PostgreSQL
# Runtime/application connection. For a serverless deployment, use the
# Supabase Supavisor pooler connection from Dashboard → Connect.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Prisma migrations/admin tooling. Prefer the Supabase direct connection.
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Authentication — generate a fresh random value for each environment.
SESSION_SECRET=""

# Development seed only — never set these in production.
SEED_CLIENT_PASSWORD=""
SEED_ADMIN_PASSWORD=""

# Supabase Storage — server-side only. Never expose the secret key to the browser.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="launchdesk-media"

# Use Supabase Storage by default. Set to "local" only for offline development.
UPLOAD_STORAGE="supabase"
